*.php  text eol=lf
*.sql  text eol=lf
*.md   text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.svg  text eol=lf
*.txt  text eol=lf
*.json text eol=lf
.htaccess text eol=lf
